# DocFlow Lite — configuración local
# Copia este archivo a .env y rellena los valores.
# Todo esto se puede poner también desde Ajustes, con la app abierta.

# IMAP (lectura de correos entrantes)
IMAP_HOST=imap.tuservidor.com
IMAP_PORT=993
IMAP_USER=tu-buzon@tuempresa.com
IMAP_PASS=

# SMTP (envío de notificaciones de devolución)
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=465
SMTP_USER=tu-buzon@tuempresa.com
SMTP_PASS=

# Rutas locales (opcional — por defecto usa ./data/)
# DATA_DIR=
# DATA_ERP_PATH=
# CONSULTA_ERP_PATH=

# Carpeta base de pedidos en red (opcional, para archivar en el pedido)
# PEDIDOS_BASE_PATH=X:uta	us\pedidos
